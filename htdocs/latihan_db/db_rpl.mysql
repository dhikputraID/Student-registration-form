create database db_rpl; ## change db_rpl to your database name, example: db_school (optional)

use db_rpl; ## use the database according to your database name

CREATE TABLE users ( id INT (11) AUTO_INCREMENT PRIMARY KEY, nama VARCHAR(100) NOT NULL, email VARCHAR(100) NOT NULL, jurusan VARCHAR(50) NOT NULL );

ALTER TABLE users ADD password VARCHAR(250) NOT NULL AFTER jurusan;
